---
import { Icon } from "astro-icon/components";
import PapersList from "@components/PapersList.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPaperLabels, getSortedPapers } from "@utils/paper-utils";

const papers = await getSortedPapers();
const labels = getPaperLabels(Astro.url.pathname);
---

<MainGridLayout
	title={i18n(I18nKey.papers, "zh")}
	description={labels.papersIntro}
	lang="zh"
>
	<div class="card-base rounded-[var(--radius-large)] px-6 py-5 md:px-9 md:py-7 mb-4 onload-animation">
		<div class="flex items-center gap-3 mb-2">
			<div class="h-10 w-10 shrink-0 rounded-lg bg-[var(--btn-regular-bg)] flex items-center justify-center">
				<Icon
					name="material-symbols:menu-book-outline-rounded"
					class="text-[1.5rem] text-[var(--primary)]"
				/>
			</div>
			<h1 class="text-2xl md:text-3xl font-bold text-90">{labels.papers}</h1>
		</div>
		<p class="text-75 text-sm md:text-[0.95rem] leading-relaxed">
			{labels.papersIntro}
		</p>
	</div>

	<PapersList papers={papers} labels={labels} />
</MainGridLayout>
