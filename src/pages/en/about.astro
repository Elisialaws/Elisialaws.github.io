---

import { getCollection, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

// English about page: src/content/spec/about.en.md
// Falls back to the Chinese about page if the English version is missing.
// Lookup by the file-based entry id, not by slug/getEntry — see the note in
// src/content/spec/about.md's page (src/pages/about.astro).
const specEntries = await getCollection("spec");
const aboutPost =
	specEntries.find((entry) => entry.id === "about.en.md") ??
	specEntries.find((entry) => entry.id === "about.md");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about, "en")} description={i18n(I18nKey.about, "en")} lang="en">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
