---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import TagPostList from "@components/TagPostList.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	getPostsByTagSlug,
	getTagIndexUrl,
	getTagLandings,
	type TagLanding,
} from "@utils/tag-utils";

export const getStaticPaths = (async () => {
	const landings = await getTagLandings("zh");
	return landings.map((landing) => ({
		params: { tag: landing.slug },
		props: { landing },
	}));
}) satisfies GetStaticPaths;

const { landing } = Astro.props as { landing: TagLanding };
const posts = await getPostsByTagSlug("zh", landing.slug);
---

<MainGridLayout
	title={`#${landing.name} · ${posts.length} 篇文章`}
	description={`汐浅的博客中所有标记为「${landing.name}」的文章，共 ${posts.length} 篇。`}
	lang="zh"
>
	<div class="card-base rounded-[var(--radius-large)] px-6 py-5 md:px-9 md:py-7 mb-4 onload-animation">
		<a
			href={getTagIndexUrl("zh")}
			class="inline-flex items-center gap-1 text-xs text-50 hover:text-[var(--primary)] transition mb-3"
		>
			<Icon
				name="material-symbols:chevron-left-rounded"
				class="text-[1rem]"
			/>
			全部标签
		</a>
		<div class="flex items-center gap-3 mb-2">
			<div
				class="h-10 w-10 shrink-0 rounded-lg bg-[var(--btn-regular-bg)] flex items-center justify-center"
			>
				<Icon
					name="material-symbols:label-outline-rounded"
					class="text-[1.5rem] text-[var(--primary)]"
				/>
			</div>
			<h1 class="text-2xl md:text-3xl font-bold text-90">#{landing.name}</h1>
		</div>
		<p class="text-75 text-sm md:text-[0.95rem] leading-relaxed">
			共 <span class="tabular-nums font-semibold text-[var(--primary)]">{posts.length}</span> 篇文章
		</p>
	</div>

	<TagPostList posts={posts} lang="zh" tagName={landing.name} />
</MainGridLayout>
