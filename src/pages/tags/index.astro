---
import TagIndex from "@components/TagIndex.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getTagLandings } from "@utils/tag-utils";

const landings = await getTagLandings("zh");
---

<MainGridLayout
	title={`全部标签 · ${landings.length} 个主题`}
	description={`按标签浏览汐浅的博客，共 ${landings.length} 个主题。`}
	lang="zh"
>
	<TagIndex lang="zh" />
</MainGridLayout>
