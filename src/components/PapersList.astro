---
import BibtexCopyScript from "@components/BibtexCopyScript.astro";
import { Icon } from "astro-icon/components";
import type { Locale } from "@i18n/translation";
import {
	getBibtex,
	getPaperUrl,
	groupByYear,
	PAPER_LINK_ICONS,
	PAPER_LINK_ORDER,
	type Paper,
	type PaperLabels,
} from "@utils/paper-utils";

interface Props {
	papers: Paper[];
	labels: PaperLabels;
	class?: string;
	lang?: Locale;
}

const { papers, labels } = Astro.props;
const lang: Locale = Astro.props.lang ?? "zh";
const className = Astro.props.class;
const groups = groupByYear(papers);

---

{
	papers.length === 0 ? (
		<div class="card-base rounded-[var(--radius-large)] p-10 md:p-14 text-center onload-animation">
			<div class="mx-auto mb-5 h-14 w-14 rounded-2xl bg-[var(--btn-regular-bg)] flex items-center justify-center">
				<Icon
					name="material-symbols:menu-book-outline-rounded"
					class="text-[2rem] text-[var(--primary)]"
				/>
			</div>
			<div class="font-bold text-lg md:text-xl text-90 mb-2">
				{labels.emptyTitle}
			</div>
			<div class="text-75 text-sm md:text-[0.95rem] max-w-lg mx-auto leading-relaxed">
				{labels.emptyHint}
			</div>
		</div>
	) : (
		<div class:list={[className, "flex flex-col gap-8 mb-4"]}>
			{groups.map((group) => (
				<section class="flex flex-col gap-4">
					<div class="flex items-center gap-3">
						<span class="text-lg md:text-xl font-bold text-90 tabular-nums">
							{group.year}
						</span>
						<div class="h-px flex-1 bg-[var(--line-divider)]" />
						<span class="text-xs text-50 tabular-nums">
							{group.papers.length}
						</span>
					</div>

					{group.papers.map((paper, index) => {
						const { data } = paper;
						const bibtex = getBibtex(paper);
						const bibId = `bib-${paper.id.replace(/[^a-zA-Z0-9-]/g, "-")}`;

						return (
							<article
								class="card-base rounded-[var(--radius-large)] p-5 md:p-6 transition group"
								style={`animation-delay: calc(var(--content-delay) + ${index * 60}ms)`}
							>
								<div class="flex flex-wrap items-center gap-2 mb-3">
									<span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
										{labels.types[data.type]}
									</span>
									<span class:list={[
										"px-2.5 py-1 rounded-md text-xs font-semibold",
										data.status === "published" || data.status === "accepted"
											? "bg-[oklch(0.94_0.04_var(--hue))] text-[oklch(0.45_0.12_var(--hue))] dark:bg-[oklch(0.3_0.06_var(--hue))] dark:text-[oklch(0.85_0.1_var(--hue))]"
											: "bg-black/[0.04] text-50 dark:bg-white/[0.08]",
									]}>
										{labels.statuses[data.status]}
									</span>
									{data.featured && (
										<span class="flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-[var(--btn-regular-bg)] text-[var(--primary)]">
											<Icon name="fa6-solid:star" class="text-[0.7rem]" />
											{labels.featured}
										</span>
									)}
								</div>

								<h2 class="font-bold text-lg md:text-xl text-90 leading-snug mb-2">
									<a
										href={getPaperUrl(paper, lang)}
										class="transition hover:text-[var(--primary)] underline decoration-transparent hover:decoration-[var(--primary)] underline-offset-4"
									>
										{data.title}
									</a>
								</h2>

								{data.authors.length > 0 && (
									<div class="text-75 text-sm md:text-[0.95rem] mb-1.5">
										{data.authors.join(", ")}
									</div>
								)}

								<div class="text-50 text-sm mb-4">
									{data.venue && <span class="italic">{data.venue}</span>}
									{data.venue && " · "}
									<span class="tabular-nums">{data.year}</span>
								</div>

								{data.abstract && (
									<details class="group/abs mb-4">
										<summary class="cursor-pointer text-sm font-semibold text-[var(--primary)] select-none list-none [&::-webkit-details-marker]:hidden flex items-center gap-1.5">
											<Icon
												name="material-symbols:chevron-right-rounded"
												class="text-[1.1rem] transition group-open/abs:rotate-90"
											/>
											{labels.abstract}
										</summary>
										<p class="mt-2 text-75 text-sm md:text-[0.95rem] leading-relaxed text-justify">
											{data.abstract}
										</p>
									</details>
								)}

								<div class="flex flex-wrap items-center gap-2">
									{PAPER_LINK_ORDER.map((key) => {
										const href = data.links[key];
										if (!href) return null;
										return (
											<a
												href={href}
												target="_blank"
												rel="noopener"
												class="btn-regular rounded-lg h-8 px-2.5 text-xs font-semibold active:scale-95"
											>
												<Icon name={PAPER_LINK_ICONS[key]} class="text-[1rem] mr-1" />
												{labels.links[key]}
											</a>
										);
									})}
									<button
										type="button"
										data-copy-bibtex={bibId}
										data-copied-label={labels.copied}
										data-failed-label={labels.copyFailed}
										class="btn-regular rounded-lg h-8 px-2.5 text-xs font-semibold active:scale-95"
									>
										<Icon
											name="material-symbols:content-copy-outline-rounded"
											class="text-[1rem] mr-1"
										/>
										{labels.bibtex}
									</button>
									<pre id={bibId} class="hidden">{bibtex}</pre>
								</div>

								{data.tags.length > 0 && (
									<div class="flex flex-wrap gap-2 mt-4">
										{data.tags.map((tag) => (
											<span class="px-2 py-0.5 rounded text-xs text-50 bg-black/[0.03] dark:bg-white/[0.06]">
												{tag}
											</span>
										))}
									</div>
								)}
							</article>
						);
					})}
				</section>
			))}
		</div>
	)
}

<BibtexCopyScript />
