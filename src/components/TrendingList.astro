---
import { getLocaleFromUrl } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import trendingData from "../data/github-trending.json";
import {
	renderTrendingRows,
	type TrendingPeriod,
	type TrendingRepo,
} from "../utils/trending.mjs";

interface Props {
	class?: string;
}

const className = Astro.props.class;
const locale = getLocaleFromUrl(Astro.url.pathname);

const periods = [
	{
		key: "daily" as const,
		zh: "今日",
		en: "Today",
		unitZh: "今日新增",
		unitEn: "today",
	},
	{
		key: "weekly" as const,
		zh: "本周",
		en: "This week",
		unitZh: "本周新增",
		unitEn: "this week",
	},
	{
		key: "monthly" as const,
		zh: "本月",
		en: "This month",
		unitZh: "本月新增",
		unitEn: "this month",
	},
];

const t = {
	title: locale === "en" ? "GitHub Trending" : "GitHub 趋势",
	intro:
		locale === "en"
			? "Repositories climbing the GitHub charts right now. Fetched live when the page opens and cached for an hour at most; the build-time snapshot is the fallback."
			: "正在 GitHub 上冒头的仓库。打开页面时实时抓取，最多缓存一小时；抓不到就退回构建时的快照。",
	// 首屏（还没拿到实时数据时）显示的是构建快照
	snapshot: locale === "en" ? "Build snapshot" : "构建快照",
	updated: locale === "en" ? "Updated" : "更新于",
	empty:
		locale === "en"
			? "No snapshot for this period yet."
			: "这一档还没有抓到数据。",
	viewAll: locale === "en" ? "Open GitHub Trending" : "打开 GitHub Trending",
	stars: locale === "en" ? "stars" : "星",
	forks: locale === "en" ? "forks" : "分叉",
};

const unitOf = (key: TrendingPeriod) =>
	locale === "en"
		? periods.find((p) => p.key === key)?.unitEn
		: periods.find((p) => p.key === key)?.unitZh;

// 首屏与前端拿到实时数据后用的是同一个渲染函数（src/utils/trending.mjs），
// 两边结构不会走样。
const rows = periods.map((p) => ({
	key: p.key,
	html: renderTrendingRows((trendingData[p.key] ?? []) as TrendingRepo[], {
		unit: unitOf(p.key),
		empty: t.empty,
		stars: t.stars,
		forks: t.forks,
	}),
}));

const fetchedAt = new Date(trendingData.fetchedAt);
const fetchedText = new Intl.DateTimeFormat(
	locale === "en" ? "en-GB" : "zh-CN",
	{
		dateStyle: "medium",
		timeStyle: "short",
		timeZone: "Asia/Shanghai",
	},
).format(fetchedAt);

// 交给前端脚本：文案 + 各档口径（单位不同，客户端重绘时要用）
const liveConfig = {
	locale,
	units: {
		daily: unitOf("daily"),
		weekly: unitOf("weekly"),
		monthly: unitOf("monthly"),
	},
	labels: { empty: t.empty, stars: t.stars, forks: t.forks },
	snapshot: t.snapshot,
	updated: t.updated,
};
---

<div
	class:list={[className, "flex flex-col gap-4 mb-4"]}
	data-trending-root
	data-trending-snapshot={trendingData.fetchedAt}
	data-trending-config={JSON.stringify(liveConfig)}
>
	<div class="card-base rounded-[var(--radius-large)] px-6 py-5 md:px-9 md:py-7 onload-animation">
		<div class="flex flex-wrap items-start justify-between gap-4">
			<div class="min-w-0">
				<div class="flex items-center gap-3 mb-2">
					<div class="h-10 w-10 shrink-0 rounded-lg bg-[var(--btn-regular-bg)] flex items-center justify-center">
						<Icon
							name="fa6-brands:github"
							class="text-[1.4rem] text-[var(--primary)]"
						/>
					</div>
					<h1 class="text-2xl md:text-3xl font-bold text-90">{t.title}</h1>
				</div>
				<p class="text-75 text-sm md:text-[0.95rem] leading-relaxed max-w-2xl">
					{t.intro}
				</p>
			</div>
			<a
				href={trendingData.source}
				target="_blank"
				rel="noopener"
				class="btn-regular rounded-lg h-9 px-3 text-xs font-semibold active:scale-95 shrink-0"
			>
				<Icon
					name="fa6-solid:arrow-up-right-from-square"
					class="text-[0.75rem] mr-1.5"
				/>
				{t.viewAll}
			</a>
		</div>

		<div class="flex items-center gap-2 mt-5">
			<div
				role="tablist"
				aria-label={t.title}
				class="flex items-center gap-1 p-1 rounded-lg bg-black/[0.04] dark:bg-white/[0.08]"
			>
				{periods.map((period, index) => (
					<button
						type="button"
						role="tab"
						data-trending-tab={period.key}
						aria-selected={index === 0 ? "true" : "false"}
						class:list={[
							"px-3 h-8 rounded-md text-sm font-bold transition active:scale-95",
							index === 0
								? "bg-[var(--primary)] text-white shadow-sm"
								: "text-50 hover:text-[var(--primary)]",
						]}
					>
						{locale === "en" ? period.en : period.zh}
					</button>
				))}
			</div>
			<div class="text-xs text-50 ml-auto flex items-center gap-1.5">
				<span
					data-trending-live-dot
					class="w-1.5 h-1.5 rounded-full bg-[var(--primary)]"
					style="display: none"
				></span>
				<span data-trending-updated>{t.snapshot} · {fetchedText}</span>
			</div>
		</div>
	</div>

	{rows.map((row, rowIndex) => (
		<div
			data-trending-panel={row.key}
			style={rowIndex === 0 ? undefined : "display: none"}
			class="flex flex-col gap-2"
			set:html={row.html}
		></div>
	))}
</div>

<script>
	import { renderTrendingRows, type TrendingPeriod, type TrendingRepo } from "../utils/trending.mjs";

	type LiveConfig = {
		locale: string;
		units: Record<string, string>;
		labels: { empty: string; stars: string; forks: string };
		snapshot: string;
		updated: string;
	};

	type LivePayload = {
		fetchedAt: string;
		daily?: TrendingRepo[];
		weekly?: TrendingRepo[];
		monthly?: TrendingRepo[];
	};

	const ENDPOINT = "/api/trending";
	const CACHE_KEY = "xiqian:trending-live:v1";
	// 这台主机上没有 /api/trending（比如 GitHub Pages）时记一笔，本次会话不再重试
	const OFF_KEY = "xiqian:trending-live:off";
	// 站点是静态的，但 Cloudflare Workers 那份会在请求时实时抓取。
	// 这里的意思是：一小时内不重复请求同一个接口。
	const CACHE_TTL = 60 * 60 * 1000;

	let inFlight: Promise<LivePayload | null> | null = null;

	function apiDisabled(): boolean {
		try {
			return sessionStorage.getItem(OFF_KEY) === "1";
		} catch {
			return false;
		}
	}

	function disableApi(): void {
		try {
			sessionStorage.setItem(OFF_KEY, "1");
		} catch {
			// 隐私模式下 sessionStorage 不可写，忽略即可
		}
	}

	function readCache(): LivePayload | null {
		try {
			const raw = sessionStorage.getItem(CACHE_KEY);
			if (!raw) return null;
			const parsed = JSON.parse(raw) as { at: number; data: LivePayload };
			if (!parsed?.data || Date.now() - parsed.at > CACHE_TTL) return null;
			return parsed.data;
		} catch {
			return null;
		}
	}

	function writeCache(data: LivePayload): void {
		try {
			sessionStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), data }));
		} catch {
			// 隐私模式下 sessionStorage 不可写，忽略即可
		}
	}

	/**
	 * 拿实时榜单。
	 * GitHub Pages 上没有 Worker，/api/trending 会 404 —— 此时返回 null，
	 * 页面保持首屏的构建快照（那边由每天定时构建刷新）。
	 */
	async function fetchLive(): Promise<LivePayload | null> {
		if (apiDisabled()) return null;
		const cached = readCache();
		if (cached) return cached;
		if (!inFlight) {
			inFlight = fetch(ENDPOINT, { headers: { accept: "application/json" } })
				.then(async (res) => {
					if (res.status === 404) {
						// 这个部署没有接口，别再反复请求
						disableApi();
						return null;
					}
					return res.ok ? ((await res.json()) as LivePayload) : null;
				})
				.catch(() => null)
				.finally(() => {
					inFlight = null;
				});
		}
		const data = await inFlight;
		if (data?.fetchedAt) writeCache(data);
		return data;
	}

	function formatTime(iso: string, locale: string): string {
		const date = new Date(iso);
		if (Number.isNaN(date.getTime())) return "";
		return new Intl.DateTimeFormat(locale === "en" ? "en-GB" : "zh-CN", {
			dateStyle: "medium",
			timeStyle: "short",
			timeZone: "Asia/Shanghai",
		}).format(date);
	}

	function readConfig(root: HTMLElement): LiveConfig | null {
		const raw = root.dataset.trendingConfig;
		if (!raw) return null;
		try {
			return JSON.parse(raw) as LiveConfig;
		} catch {
			return null;
		}
	}

	/** 用实时数据重绘三档列表；数据比首屏快照更旧的话就什么都不做 */
	async function upgradeToLive(): Promise<void> {
		const root = document.querySelector<HTMLElement>("[data-trending-root]");
		if (!root) return;
		const config = readConfig(root);
		if (!config) return;

		const data = await fetchLive();
		if (!data?.fetchedAt) return;

		const snapshotAt = new Date(root.dataset.trendingSnapshot ?? 0).getTime();
		if (new Date(data.fetchedAt).getTime() <= snapshotAt) return;

		let painted = 0;
		for (const key of ["daily", "weekly", "monthly"] as TrendingPeriod[]) {
			const items = data[key];
			if (!Array.isArray(items) || items.length === 0) continue;
			const panel = root.querySelector<HTMLElement>(
				`[data-trending-panel="${key}"]`,
			);
			if (!panel) continue;
			panel.innerHTML = renderTrendingRows(items, {
				unit: config.units[key],
				...config.labels,
			});
			painted += 1;
		}
		if (!painted) return;

		// 计数说清楚现在是实时数据，而不是构建快照
		const label = root.querySelector<HTMLElement>("[data-trending-updated]");
		if (label) {
			label.textContent = `${config.updated} · ${formatTime(data.fetchedAt, config.locale)}`;
		}
		const dot = root.querySelector<HTMLElement>("[data-trending-live-dot]");
		if (dot) dot.style.display = "";
	}

	// 文档级事件委托：swup 换页后无需重新绑定
	function activate(key: string) {
		const buttons = document.querySelectorAll<HTMLButtonElement>(
			"[data-trending-tab]",
		);
		const panels = document.querySelectorAll<HTMLElement>(
			"[data-trending-panel]",
		);
		if (!buttons.length) return;

		buttons.forEach((button) => {
			const active = button.dataset.trendingTab === key;
			button.setAttribute("aria-selected", active ? "true" : "false");
			button.classList.toggle("bg-[var(--primary)]", active);
			button.classList.toggle("text-white", active);
			button.classList.toggle("shadow-sm", active);
			button.classList.toggle("text-50", !active);
			button.classList.toggle("hover:text-[var(--primary)]", !active);
		});
		panels.forEach((panel) => {
			// 用内联 display 而不是 hidden 属性：面板自带 flex 类，
			// 类选择器会盖掉 UA 的 [hidden]{display:none}
			panel.style.display = panel.dataset.trendingPanel === key ? "" : "none";
		});
	}

	document.addEventListener("click", (event) => {
		const target = event.target as HTMLElement | null;
		const button = target?.closest<HTMLButtonElement>("[data-trending-tab]");
		if (!button?.dataset.trendingTab) return;
		event.preventDefault();
		activate(button.dataset.trendingTab);
	});

	upgradeToLive();

	// swup 换页后重新进入趋势页时补一次（第一次已在上面的调用里处理）
	const swup = (
		window as unknown as {
			swup?: { hooks: { on: (event: string, cb: () => void) => void } };
		}
	).swup;
	swup?.hooks?.on("page:view", upgradeToLive);
</script>
