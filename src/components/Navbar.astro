---
import { Icon } from "astro-icon/components";
import { navBarConfig, profileConfig, siteConfig } from "../config";
import { getLinkPresets } from "../constants/link-presets";
import { getLocaleFromUrl, localePath } from "../i18n/translation";
import { LinkPreset, type NavBarLink } from "../types/config";
import { getLangSwitchInfo } from "../utils/lang-utils";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

// Locale of the current page, derived from the URL
const locale = getLocaleFromUrl(Astro.url.pathname);
// Localized site title for the navbar logo
const siteTitle =
	locale === "en" ? siteConfig.titleEn || siteConfig.title : siteConfig.title;
// Both sides of the 中/EN language switch (counterpart page or fallback home)
const langSwitch = await getLangSwitchInfo(Astro.url.pathname);
const homeUrl = url(localePath(locale, "/"));

const linkPresets = getLinkPresets(locale);
let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return linkPresets[item];
		}
		return item;
	},
);

// GitHub entry from the profile links: shown as an icon in the button cluster
const githubLink = profileConfig.links.find((l) =>
	l.icon.toLowerCase().includes("github"),
);
// The mobile menu panel also lists GitHub (the icon is hidden on tiny screens)
const menuLinks: NavBarLink[] = githubLink
	? [...links, { name: githubLink.name, url: githubLink.url, external: true }]
	: links;
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={homeUrl} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
                {siteTitle}
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex items-center">
            <!-- Language switch: 中 | EN segmented control. The current language is
                 highlighted; the other segment links to the counterpart page. Full reload
                 (data-no-swup) so locale-dependent client components re-initialize. -->
            <div id="lang-switch" role="group" aria-label={locale === "zh" ? "语言切换" : "Language"}
                 class="flex items-center h-8 mx-1 px-0.5 rounded-lg select-none bg-black/[0.04] dark:bg-white/[0.08] text-xs font-bold">
                {(["zh", "en"] as const).map((key) => {
                    const side = langSwitch[key];
                    const active = locale === key;
                    return <a id={`lang-switch-${key}`} href={side.url} title={side.title} aria-label={side.title}
                              data-no-swup
                              aria-current={active ? "true" : undefined}
                              tabindex={active ? "-1" : undefined}
                              class="flex items-center justify-center h-7 px-2 rounded-md transition text-black/45 dark:text-white/45 hover:text-[var(--primary)] active:scale-95"
                    >{key === "zh" ? "中" : "EN"}</a>;
                })}
            </div>
            <!-- GitHub: shown as an icon next to the language & theme switches.
                 Hidden on very small screens, where the mobile menu still lists it. -->
            {githubLink && (
                <a href={githubLink.url} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub"
                   class="hidden sm:flex btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90">
                    <Icon name={githubLink.icon} class="text-[1.25rem]"></Icon>
                </a>
            )}
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte" lang={locale}></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="hidden sm:flex btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:only="svelte" lang={locale}></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={menuLinks}></NavMenuPanel>
        <DisplaySettings client:only="svelte" lang={locale}></DisplaySettings>
    </div>
</div>

<script>
function loadButtonScript() {
    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();
</script>

<style>
    /* Active language segment of the 中/EN switch: highlighted pill, not clickable */
    #lang-switch a[aria-current="true"] {
        background: var(--card-bg);
        color: var(--primary);
        pointer-events: none;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
    }
</style>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
