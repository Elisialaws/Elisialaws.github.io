---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@i18n/translation";
import { getPostUrlSlug } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

interface Props {
	page: {
		data: CollectionEntry<"posts">[];
	};
	lang?: Locale;
}

const { page } = Astro.props;
const lang = Astro.props.lang ?? "zh";

let delay = 0;
const interval = 50;
---
<div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
    {page.data.map((entry: CollectionEntry<"posts">) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(getPostUrlSlug(entry), lang)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                lang={lang}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
</div>
